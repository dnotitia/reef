{
  "name": "reef-workspace",
  "version": "0.9.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Dnotitia Inc.",
  "homepage": "https://github.com/dnotitia/reef#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnotitia/reef.git"
  },
  "bugs": {
    "url": "https://github.com/dnotitia/reef/issues"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @reef/web dev",
    "build": "pnpm --filter @reef/web build",
    "build:packages": "node scripts/clean-package-artifacts.mjs && pnpm --filter @reef/core run build && pnpm --filter @reef/orchestrator run build && pnpm --filter @reef/harness-provider-codex run build && pnpm --filter @reef/infrastructure-provider-local run build && pnpm --filter @reef/work-provider-reef run build && pnpm --filter @reef/jira-migrator run build",
    "package-contract:smoke": "node scripts/package-contract-smoke.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "check:package-contract": "pnpm run build:packages && pnpm run package-contract:smoke && pnpm run architecture:check",
    "lint": "biome check .",
    "check": "pnpm run check:package-contract && pnpm run lint && pnpm run typecheck && pnpm run maintenance:test && pnpm run test && pnpm run check:release",
    "check:release": "node scripts/check-release-policy.mjs",
    "maintenance:scan": "node scripts/maintenance/scan.mjs",
    "maintenance:assert-clean": "node scripts/maintenance/scan.mjs --assert-clean",
    "maintenance:duplicates": "node scripts/maintenance/scan.mjs duplicates",
    "maintenance:dead-code": "node scripts/maintenance/scan.mjs dead-code",
    "maintenance:lint": "node scripts/maintenance/scan.mjs maintenance-lint",
    "maintenance:large-files": "node scripts/maintenance/scan.mjs large-files",
    "maintenance:test-profile": "node scripts/maintenance/scan.mjs slow-tests",
    "maintenance:comments": "node scripts/maintenance/scan.mjs comment-claims",
    "maintenance:test": "node --test scripts/maintenance/scan.test.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "dependency-cruiser": "18.1.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jscpd": "^5.0.6",
    "knip": "^6.16.1",
    "tsdown": "^0.21.10",
    "typescript-eslint": "^8.61.0"
  }
}
