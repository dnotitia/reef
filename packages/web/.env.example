# reef-web environment variables.
#
# Mostly server-only values. Anything that needs to reach the browser must use a
# NEXT_PUBLIC_* prefix; the only one is NEXT_PUBLIC_AKB_WEB_URL below (a public
# address, not a secret). LLM and GitHub App credentials stay
# server-side. Local auth uses an httpOnly AKB JWT cookie; SSO uses only an
# opaque httpOnly handle and keeps every OIDC token encrypted server-side.

# Required explicit auth profile. `local` preserves AKB username/password + JWT.
REEF_AUTH_MODE=local

# Base URL of the AKB backend. Local dev normally uses localhost; container
# deployments can use their AKB service name.
AKB_BACKEND_URL=http://localhost:8000

# To develop the Reef-owned OIDC BFF, replace REEF_AUTH_MODE above with `sso`
# and configure a dedicated public Keycloak client. These values are server-only.
# Production requires Redis plus an independent 32-byte encryption key; tests
# and non-production development may omit both to use an in-memory store with an
# ephemeral key. Generate a deployment key with `openssl rand -base64 32` and
# store it in a secret manager, never this file.
# REEF_KEYCLOAK_ISSUER=https://identity.example.com/realms/reef
# Production-only internal transport for token/JWKS/revocation calls. It must
# use the same exact realm path as the issuer and a non-IP in-cluster DNS name.
# REEF_KEYCLOAK_TRANSPORT_URL=http://keycloak.identity.svc.cluster.local:8080/realms/reef
# REEF_KEYCLOAK_CLIENT_ID=reef-web
# REEF_AKB_API_AUDIENCE=akb-api
# REEF_SESSION_REDIS_URL=redis://localhost:6379/0
# REEF_SESSION_ENCRYPTION_KEY=

# Canonical external origin of this Reef deployment. Required in SSO mode and
# used to form the exact callback and post-logout URLs. Bare origin only; HTTPS
# except for localhost/loopback development.
# REEF_PUBLIC_ORIGIN=https://reef.example.com

# Optional SSO-first redirect. Set to 1/true only when the deployment wants a
# clean /login entry to start its single configured SSO provider automatically.
# An explicit AKB sso_only policy has the same behavior; unset keeps the
# hybrid button-first panel.
# REEF_SSO_AUTO_REDIRECT=1

# Public base URL of the akb web app, used to open a linked document in a new tab
# from an issue's "Linked documents" section (REEF-083). Unset → the open action
# is hidden and only copy-URI is offered. Not a secret; safe to inline in the
# browser bundle.
# NEXT_PUBLIC_AKB_WEB_URL=https://akb.example.com

# Optional deployment-managed OpenAI-compatible LLM endpoint. Set all three to
# enable AI, or leave all three empty for a valid disabled state. The URL can
# point to OpenRouter or an akb-platform gateway; Reef does not classify it.
REEF_LLM_API_KEY=
REEF_LLM_BASE_URL=
REEF_LLM_MODEL=

# Deployment-managed GitHub App used for monitored-repo listing, grounding, and
# activity scans. Browser users do not paste or store GitHub tokens.
# REEF_GITHUB_APP_ID=
# REEF_GITHUB_APP_INSTALLATION_ID=
# REEF_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional dev/CI fallback when no GitHub App is configured. This is still a
# deployment-managed server secret, not a per-user browser token.
# REEF_GITHUB_PAT=
