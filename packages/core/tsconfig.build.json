{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "exclude": [
    "**/*.test.ts",
    "**/*.testSupport.ts",
    "**/*TestSupport.ts",
    "**/*Fixtures.ts",
    "**/__test-helpers__/**",
    "node_modules",
    "dist"
  ]
}
