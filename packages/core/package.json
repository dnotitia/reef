{
  "name": "@reef/core",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./status": {
      "types": "./dist/models/status.d.ts",
      "import": "./dist/models/status.js",
      "default": "./dist/models/status.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "default": "./dist/errors/index.js"
    },
    "./fields": {
      "types": "./dist/schemas/issues/fieldRegistry.d.ts",
      "import": "./dist/schemas/issues/fieldRegistry.js",
      "default": "./dist/schemas/issues/fieldRegistry.js"
    },
    "./fields/planning": {
      "types": "./dist/schemas/planning/fieldRegistry.d.ts",
      "import": "./dist/schemas/planning/fieldRegistry.js",
      "default": "./dist/schemas/planning/fieldRegistry.js"
    }
  },
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.mjs --filter @reef/core",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live-akb": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "0.22.14",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "eventsource-parser": "3.0.8",
    "zod": "^4.4.3"
  }
}
