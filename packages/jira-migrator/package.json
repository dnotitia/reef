{
  "name": "@reef/jira-migrator",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "reef-jira-migrator": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.mjs --filter @reef/jira-migrator",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:behavior": "node scripts/behavior-contract.mjs",
    "start": "tsx src/cli.ts",
    "smoke:dry-run": "tsx src/cli.ts --dry-run"
  },
  "dependencies": {
    "@reef/core": "workspace:*",
    "proper-lockfile": "4.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
