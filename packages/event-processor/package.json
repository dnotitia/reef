    "test": "vitest run"
  },
  "dependencies": {
    "@reef/core": "workspace:*",
    "p-limit": "7.3.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
